# Formulário de contato (/api/contact)
#
# Sem RESEND_API_KEY e CONTACT_TO o formulário responde erro e mostra o
# caminho manual (endereço + mensagem pra copiar). Configurar em:
# Vercel → o projeto → Settings → Environment Variables
# (Production + Preview + Development).

# Chave da conta Resend. Na conta já existe a chave "Portfolio Form", com
# permissão só de envio e travada em send.rodrigobondioli.com — se vazar,
# só serve pra mandar e-mail por esse domínio.
RESEND_API_KEY=

# Pra onde a mensagem é enviada
CONTACT_TO=rodrigobondioli@gmail.com

# Remetente. send.rodrigobondioli.com já está verificado na Resend, então o
# e-mail sai assinado (SPF/DKIM) de um endereço nosso, e não do
# onboarding@resend.dev — que só entregaria pro e-mail da própria conta.
CONTACT_FROM="Portfolio <site@send.rodrigobondioli.com>"

# Só pra teste local apontando num servidor falso. Em produção, vazio.
RESEND_API_URL=
